# Crie uma cópia como .env na RAIZ do projeto. NÃO compartilhe o arquivo .env.
GEMINI_API_KEY=COLOQUE_SUA_CHAVE_AQUI
# Modelo estável rápido com respostas JSON estruturadas:
GEMINI_MODELO=gemini-3.5-flash-lite
# Modelo alternativo, usado só se o principal não estiver disponível (HTTP 404):
GEMINI_FALLBACK=gemini-3.5-flash
GEMINI_TIMEOUT=45
PORTA=8000
# 1 = o Gemini formula as perguntas de forma natural; 0 = perguntas fixas do roteiro (mais rápido)
PERGUNTAS_NATURAIS=1
